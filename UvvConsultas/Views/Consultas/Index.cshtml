@model IEnumerable<UvvConsultas.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Minhas Consultas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Consulta</a>
</div>

@if (!Model.Any())
{
    <p>Você ainda não tem consultas agendadas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Especialidade)</th>
                <th>@Html.DisplayNameFor(model => model.DataHora)</th>
                <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Especialidade)</td>
                    <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdConsulta" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdConsulta" class="btn btn-info btn-sm">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.IdConsulta" class="btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
