@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Bem-vindo ao Sistema de Gestão de Consultas UVV</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <p>Olá, @User.Identity.Name!</p>
        <p>
            <a asp-controller="Consultas" asp-action="Index" class="btn btn-primary">Ver Minhas Consultas</a>
        </p>
        <form asp-controller="Usuarios" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-danger">Sair</button>
        </form>
    }
    else
    {
        <p>
            <a asp-controller="Usuarios" asp-action="Login" class="btn btn-primary">Entrar</a>
            <a asp-controller="Usuarios" asp-action="Registro" class="btn btn-success">Cadastrar</a>
        </p>
    }
</div>